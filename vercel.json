{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{venv/**,.venv/**,.codex_deps/**,__pycache__/**,**/*.pyc,.git/**,.agents/**,.codex/**}"
    }
  }
}
